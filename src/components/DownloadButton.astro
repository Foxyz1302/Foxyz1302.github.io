---
// The Download button. At build time it knows the latest release and its
// files; in the browser a small script picks the file for the visitor's
// system ("Download for Windows"). Without JS, or when nothing matches, the
// button opens the release page. When a file download starts, a small
// thank-you panel asks for an optional tip (once per visit; never in the
// compact embed).
import Icon from './Icon.astro';
import { t, href, donationsFor, PLATFORM_LABEL, type App, type Lang } from '../lib/data';
import { formatSize, releasesPage, type Release } from '../lib/releases';
import { ui } from '../i18n/ui';

interface Props { app: App; release: Release | null; lang: Lang; compact?: boolean; target?: string }
const { app, release, lang, compact = false, target } = Astro.props;
const s = ui(lang);
const fallback = release?.pageUrl ?? releasesPage(app);
const assets = (release?.assets ?? []).map((a) => ({ ...a, label: PLATFORM_LABEL[a.platform] ?? a.platform, sizeText: formatSize(a.size) }));
const rel = target === '_blank' ? 'noopener' : undefined;
const tip = donationsFor(lang).find((o) => o.kind === 'link' && o.url);
const fill = (x: string) => x.replaceAll('{app}', app.name);
---
{fallback ? (
  <div class:list={['dl', { compact }]} data-dl data-assets={JSON.stringify(assets)} data-label-for={s('apps.downloadFor')}>
    <a class="btn btn-primary dl-main" href={fallback} target={target} rel={rel} data-dl-main data-goatcounter-click={`download-${app.id}`}>
      <Icon name="download" /><span data-dl-text>{s('apps.download')}</span>
    </a>
    {!compact && (
      <div class="dl-meta">
        {release && <span class="mono">v{release.version}</span>}
        <span class="mono" data-dl-size></span>
        <span class="dl-none" data-dl-none hidden>{s('apps.notForYou')}</span>
      </div>
    )}
    {!compact && assets.length > 0 && (
      <details class="dl-other" data-dl-other>
        <summary>{s('apps.otherPlatforms')}</summary>
        <ul>
          {assets.map((a) => (
            <li><a href={a.url} target={target} rel={rel} data-file data-goatcounter-click={`download-${app.id}-${a.platform}`}><Icon name={a.platform} /><span>{a.label}</span><span class="mono muted">{a.name}</span><span class="mono muted">{a.sizeText}</span></a></li>
          ))}
        </ul>
        {release && <a class="dl-all" href={release.listUrl} target={target} rel={rel}>{s('apps.allReleases')} <Icon name="arrow" /></a>}
      </details>
    )}
    {!compact && (
      <dialog class="thanks" data-thanks={app.id}>
        <h2>{fill(s('dl.thanksTitle'))}</h2>
        <p>{fill(s('dl.thanksText'))}</p>
        <div class="thanks-actions">
          {tip && <a class="btn btn-primary" href={tip.url} target="_blank" rel="noopener" data-goatcounter-click={`thanks-support-${tip.id}`}><Icon name="heart" />{s('dl.tipOn')} {t(tip.name, lang)}</a>}
          <a class="btn btn-ghost" href={href('/support/', lang)} data-goatcounter-click="thanks-support-page">{s('dl.moreWays')}</a>
        </div>
        <form method="dialog"><button class="thanks-close">{s('dl.close')}</button></form>
      </dialog>
    )}
  </div>
) : (
  <p class="muted">{s('apps.noBuildYet')}</p>
)}

<script>
  function visitorOS(): string | null {
    const ua = navigator.userAgent;
    const p = ((navigator as any).userAgentData?.platform ?? navigator.platform ?? '').toLowerCase();
    if (/android/i.test(ua)) return 'android';
    if (/iphone|ipad|ipod/i.test(ua)) return 'ios';
    if (p.includes('win') || /windows/i.test(ua)) return 'windows';
    if (p.includes('mac')) return 'macos';
    if (p.includes('linux') || /linux|x11|cros/i.test(ua)) return 'linux';
    return null;
  }
  const os = visitorOS();
  document.querySelectorAll<HTMLElement>('[data-dl]').forEach((box) => {
    const assets = JSON.parse(box.dataset.assets || '[]');
    if (!assets.length) return;
    const match = assets.find((a: any) => a.platform.split('-')[0] === os);
    const main = box.querySelector<HTMLAnchorElement>('[data-dl-main]')!;
    if (match) {
      main.href = match.url;
      main.dataset.file = '';
      main.querySelector('[data-dl-text]')!.textContent = `${box.dataset.labelFor} ${match.label}`;
      const size = box.querySelector('[data-dl-size]');
      if (size && match.sizeText) size.textContent = match.sizeText;
    } else {
      box.querySelector<HTMLElement>('[data-dl-none]')?.removeAttribute('hidden');
      box.querySelector<HTMLDetailsElement>('[data-dl-other]')?.setAttribute('open', '');
    }
  });

  // Thank-you panel: the download starts as usual; the panel opens just after,
  // once per visit and app. Click outside or Close to dismiss.
  document.querySelectorAll<HTMLDialogElement>('dialog[data-thanks]').forEach((dlg) => {
    const key = `thanks-${dlg.dataset.thanks}`;
    dlg.closest('[data-dl]')?.addEventListener('click', (e) => {
      if (!(e.target as Element).closest('[data-file]')) return;
      try { if (sessionStorage.getItem(key)) return; sessionStorage.setItem(key, '1'); } catch {}
      setTimeout(() => dlg.showModal(), 350);
    });
    dlg.addEventListener('click', (e) => { if (e.target === dlg) dlg.close(); });
  });
</script>

<style>
  .dl { display: grid; gap: 0.7rem; justify-items: start; }
  .dl-main { --h: 54px; padding: 0 1.7rem; font-size: 1.02rem; }
  .compact .dl-main { --h: 40px; padding: 0 1.1rem; font-size: 0.9rem; }
  .dl-meta { display: flex; flex-wrap: wrap; gap: 0.3rem 0.9rem; font-size: 0.8rem; color: var(--muted); }
  .dl-none { color: var(--warn); font-size: 0.85rem; }
  .dl-other { width: 100%; font-size: 0.9rem; }
  .dl-other summary { cursor: pointer; color: var(--muted); list-style: none; display: inline-flex; gap: 0.4rem; align-items: center; }
  .dl-other summary::before { content: '▸'; color: var(--primary); transition: transform 0.2s; }
  .dl-other[open] summary::before { transform: rotate(90deg); }
  .dl-other summary:hover { color: var(--text-strong); }
  .dl-other ul { list-style: none; padding: 0; margin-top: 0.6rem; display: grid; gap: 0.35rem; }
  .dl-other li a {
    display: grid;
    grid-template-columns: 20px auto 1fr auto;
    align-items: center;
    gap: 0.6rem;
    padding: 0.55rem 0.75rem;
    border-radius: var(--radius-sm);
    background: rgba(0, 0, 0, 0.25);
    border: 1px solid var(--border-soft);
    transition: border-color 0.2s;
  }
  .dl-other li a:hover { border-color: var(--primary); }
  .dl-other li :global(svg) { width: 18px; height: 18px; }
  .dl-other li .mono { font-size: 0.72rem; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .dl-all { display: inline-flex; align-items: center; gap: 0.3rem; margin-top: 0.6rem; color: var(--accent); font-size: 0.85rem; }
  .dl-all :global(svg) { width: 14px; height: 14px; }

  .thanks { margin: auto; max-width: min(440px, calc(100vw - 32px)); padding: 1.6rem 1.6rem 1.2rem; border-radius: var(--radius); border: 1px solid var(--border); background: var(--bg-raised); color: var(--text); box-shadow: 0 24px 60px rgba(0, 0, 0, 0.5); }
  .thanks::backdrop { background: rgba(0, 0, 0, 0.6); }
  .thanks h2 { font-size: 1.3rem; margin-bottom: 0.6rem; }
  .thanks p { color: var(--muted); margin-bottom: 1.2rem; }
  .thanks-actions { display: flex; flex-wrap: wrap; gap: 0.6rem; }
  .thanks form { margin-top: 0.9rem; }
  .thanks-close { background: none; border: 0; padding: 0.3rem 0; color: var(--muted); font: inherit; font-size: 0.88rem; cursor: pointer; }
  .thanks-close:hover { color: var(--text-strong); }
</style>
