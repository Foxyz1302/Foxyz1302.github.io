---
// Placeholder art for apps without an icon: a flat tile in the theme's
// colours with the title's initials, and a round badge on its corner with the
// logo of what it is built with (Flutter unless the app says otherwise).
import { TECH_ICON, TECH_NAME, TECH_COLOR } from '../lib/tech-icons';
import type { App } from '../lib/data';

interface Props { app: App; size?: number }
const { app, size = 56 } = Astro.props;
const tech = app.tech ?? 'flutter';
const badge = Math.round(size * 0.46);
const initials = app.name.split(/\s+/).filter((w) => /^[\p{L}\d]/u.test(w)).slice(0, 2).map((w) => w[0].toUpperCase()).join('');
---
<span class="art" style={`--size:${size}px; --badge:${badge}px`}>
  <svg class="tile" viewBox="0 0 64 64" width={size} height={size} role="img" aria-label={app.name}>
    <rect x="0.5" y="0.5" width="63" height="63" rx="13" style="fill: var(--panel-strong); stroke: var(--border)" />
    <text x="32" y="39.5" text-anchor="middle" font-weight="800" font-size="20" style="font-family: var(--font-head); fill: var(--text)">{initials}</text>
  </svg>
  <span class="badge" style={`background:${TECH_COLOR[tech]}`} title={TECH_NAME[tech]}>
    <svg viewBox="0 0 24 24" fill="#fff" aria-label={TECH_NAME[tech]} role="img"><path d={TECH_ICON[tech]} /></svg>
  </span>
</span>

<style>
  .art { position: relative; display: block; flex: none; width: var(--size); height: var(--size); }
  .tile { display: block; overflow: visible; }
  .badge {
    position: absolute;
    right: calc(var(--badge) * -0.3);
    bottom: calc(var(--badge) * -0.3);
    width: var(--badge);
    height: var(--badge);
    border-radius: 50%;
    display: grid;
    place-items: center;
    box-shadow: 0 0 0 3px var(--card-bg);
  }
  .badge svg { width: 62%; height: 62%; }
</style>
