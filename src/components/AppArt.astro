---
// Placeholder art for apps without an icon: a flat tile in the theme's
// colours with the title's initials and a small stamp in the corner (a nod to
// the logo). Which corner, and whether the stamp is red or gold, comes from
// the app id, so neighbouring tiles differ a little.
import type { App } from '../lib/data';

interface Props { app: App; size?: number }
const { app, size = 56 } = Astro.props;
let h = 0;
for (const ch of app.id) h = (h * 31 + ch.charCodeAt(0)) >>> 0;
const right = h % 2 === 0;
const stamp = (h >> 1) % 3 === 0 ? 'var(--accent)' : 'var(--primary)';
const initials = app.name.split(/\s+/).filter((w) => /^[\p{L}\d]/u.test(w)).slice(0, 2).map((w) => w[0].toUpperCase()).join('');
---
<svg class="app-art" viewBox="0 0 64 64" width={size} height={size} role="img" aria-label={app.name}>
  <rect x="0.5" y="0.5" width="63" height="63" rx="13" style="fill: var(--panel-strong); stroke: var(--border)" />
  <rect x={right ? 46 : 8} y="8" width="10" height="10" rx="2.5" transform={`rotate(${right ? 8 : -8} ${right ? 51 : 13} 13)`} style={`fill: ${stamp}`} />
  <text x="32" y="41" text-anchor="middle" font-weight="800" font-size="19" style="font-family: var(--font-head); fill: var(--text)">{initials}</text>
</svg>

<style>
  .app-art { display: block; flex: none; border-radius: 13px; }
</style>
