---
import Icon from './Icon.astro';
import { data, href, type Lang } from '../lib/data';
import { ui } from '../i18n/ui';

interface Props { lang: Lang; path: string }
const { lang, path } = Astro.props;
const s = ui(lang);
const other: Lang = lang === 'en' ? 'ru' : 'en';

const links = [
  { path: '/apps/', label: s('nav.apps') },
  { path: '/commissions/', label: s('nav.commissions') },
  { path: '/about/', label: s('nav.about') },
];
const isActive = (p: string) => path.startsWith(p);
---
<header class="site-header">
  <div class="container bar">
    <a class="brand" href={href('/', lang)} aria-label={data.person.name}>
      <img src="/mark.svg" alt="" width="30" height="30" />
      <span>{data.person.name}</span>
    </a>

    <button class="menu-btn" type="button" aria-expanded="false" aria-controls="site-nav" data-menu>
      <Icon name="menu" />
      <span class="sr-only">{s('nav.menu')}</span>
    </button>

    <nav id="site-nav" class="nav" data-nav>
      {links.map((l) => (
        <a href={href(l.path, lang)} class:list={['nav-link', { active: isActive(l.path) }]} aria-current={isActive(l.path) ? 'page' : undefined}>{l.label}</a>
      ))}
      <a href={href(path, other)} class="nav-link lang" hreflang={other} data-lang-link={other} title={s('lang.switch')}>
        <Icon name="globe" />{other.toUpperCase()}
      </a>
      <a href={href('/support/', lang)} class="btn btn-sm btn-primary nav-cta"><Icon name="heart" />{s('nav.support')}</a>
    </nav>
  </div>
</header>

<script>
  const btn = document.querySelector<HTMLButtonElement>('[data-menu]');
  const nav = document.querySelector<HTMLElement>('[data-nav]');
  btn?.addEventListener('click', () => {
    const open = btn.getAttribute('aria-expanded') !== 'true';
    btn.setAttribute('aria-expanded', String(open));
    nav?.classList.toggle('open', open);
  });
</script>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: rgba(8, 4, 10, 0.72);
    backdrop-filter: blur(16px) saturate(140%);
    -webkit-backdrop-filter: blur(16px) saturate(140%);
    border-bottom: 1px solid var(--border-soft);
  }
  .bar { display: flex; align-items: center; gap: 1rem; min-height: 64px; }
  .brand { display: flex; align-items: center; gap: 0.6rem; font-weight: 700; font-size: 1.3rem; letter-spacing: -0.03em; margin-right: auto; }
  .brand img { filter: drop-shadow(0 0 10px rgba(189, 0, 255, 0.45)); transition: transform 0.4s var(--ease); }
  .brand:hover img { transform: rotate(-8deg) scale(1.06); }
  .nav { display: flex; align-items: center; gap: 0.3rem; }
  .nav-link {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    padding: 0.45rem 0.8rem;
    border-radius: 999px;
    color: var(--muted);
    font-weight: 500;
    transition: color 0.2s, background 0.2s;
  }
  .nav-link:hover { color: white; background: rgba(255, 255, 255, 0.05); }
  .nav-link.active { color: white; background: var(--primary-soft); }
  .nav-link.lang { font-family: var(--mono); font-size: 0.8rem; }
  .nav-link :global(svg) { width: 16px; height: 16px; }
  .nav-cta { margin-left: 0.4rem; }
  .menu-btn { display: none; background: none; border: 1px solid var(--border-soft); color: white; border-radius: 10px; padding: 0.45rem; cursor: pointer; }
  .menu-btn :global(svg) { width: 22px; height: 22px; }
  .sr-only { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); }

  @media (max-width: 760px) {
    .menu-btn { display: block; }
    .nav {
      position: absolute;
      top: 100%;
      left: 0;
      right: 0;
      flex-direction: column;
      align-items: stretch;
      gap: 0.2rem;
      padding: 0.8rem var(--gutter) 1.2rem;
      background: rgba(10, 5, 14, 0.97);
      border-bottom: 1px solid var(--border);
      transform: translateY(-8px);
      opacity: 0;
      visibility: hidden;
      transition: opacity 0.25s, transform 0.3s var(--ease), visibility 0.25s;
    }
    .nav.open { opacity: 1; transform: none; visibility: visible; }
    .nav-link { padding: 0.75rem 0.9rem; font-size: 1.05rem; }
    .nav-cta { margin: 0.5rem 0 0; }
  }
</style>
