---
import Icon from './Icon.astro';
import AppArt from './AppArt.astro';
import { t, href, PLATFORM_LABEL, type App, type Lang } from '../lib/data';
import { ui } from '../i18n/ui';

interface Props { app: App; lang: Lang; delay?: number }
const { app, lang, delay = 0 } = Astro.props;
const s = ui(lang);
---
<a href={href(`/apps/${app.id}/`, lang)} class:list={['card app-card reveal', { 'is-placeholder': app.placeholder }]} style={`--d:${delay}s`}>
  <div class="app-top">
    {app.icon ? <img class="app-icon" src={app.icon} alt="" width="64" height="64" loading="lazy" /> : <AppArt app={app} size={64} />}
    <div>
      <h3>{app.name} {app.placeholder && <span class="todo-badge">{s('todo')}</span>}</h3>
      <span class:list={['status', app.status]}>{s(`apps.status.${app.status}`)}</span>
    </div>
  </div>
  <p class="muted">{t(app.pitch, lang)}</p>
  <div class="app-foot">
    <div class="plats" title={app.platforms.map((p) => PLATFORM_LABEL[p]).join(', ')}>
      {app.platforms.map((p) => <Icon name={p} />)}
    </div>
    <span class="more">{s('apps.details')} <Icon name="arrow" /></span>
  </div>
</a>

<style>
  .app-card { display: flex; flex-direction: column; gap: 1rem; min-height: 220px; }
  .app-top { display: flex; align-items: center; gap: 1rem; }
  .app-icon { width: 64px; height: 64px; border-radius: 16px; box-shadow: 0 8px 24px -8px rgba(0, 0, 0, 0.8); transition: transform 0.4s var(--ease); }
  .app-card:hover .app-icon { transform: scale(1.06) rotate(-3deg); }
  .app-top h3 { font-size: var(--step-2); margin-bottom: 0.2rem; }
  .app-card p { flex: 1; }
  .app-foot { display: flex; align-items: center; justify-content: space-between; border-top: 1px solid var(--border-soft); padding-top: 0.9rem; }
  .plats { display: flex; gap: 0.55rem; color: var(--muted); }
  .plats :global(svg) { width: 18px; height: 18px; }
  .more { display: inline-flex; align-items: center; gap: 0.35rem; font-size: 0.88rem; color: var(--accent); }
  .more :global(svg) { width: 16px; height: 16px; transition: transform 0.3s var(--ease); }
  .app-card:hover .more :global(svg) { transform: translateX(4px); }
</style>
