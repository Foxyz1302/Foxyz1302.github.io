---
import QRCode from 'qrcode';
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import { t, donationsFor, type Lang } from '../lib/data';
import { md } from '../lib/content';
import { ui } from '../i18n/ui';

interface Props { lang: Lang }
const { lang } = Astro.props;
const s = ui(lang);
const page = md('support', lang);
// Order comes from data.json → donations.order[lang]: crypto is listed last there.
const options = donationsFor(lang);
const links = options.filter((o) => o.kind === 'link');
const crypto = await Promise.all(
  options
    .filter((o) => o.kind === 'crypto' && o.address)
    .map(async (o) => ({
      ...o,
      qr: await QRCode.toString(o.address!, { type: 'svg', margin: 1, color: { dark: '#14001f', light: '#ffffff' } }),
    })),
);
---
<Base lang={lang} title={s('sup.title')} description={page.frontmatter.lead}>
  <div class="container page-head">
    <span class="eyebrow">{s('sup.title')}</span>
    <h1 class="gradient-text">{page.frontmatter.title}</h1>
    <p class="lead">{page.frontmatter.lead}</p>
  </div>

  <section class="container section-tight">
    <div class="grid links">
      {links.map((o, i) => (
        <a href={o.url} target="_blank" rel="noopener" data-goatcounter-click={`support-${o.id}`} class:list={['card link-opt reveal', { first: i === 0, 'is-placeholder': o.placeholder }]} style={`--d:${i * 0.06}s`}>
          <div class="opt-icon"><Icon name={o.id === 'kofi' ? 'kofi' : 'heart'} /></div>
          <div class="opt-text">
            <h3>{t(o.name, lang)} {o.placeholder && <span class="todo-badge">{s('todo')}</span>}</h3>
            {o.note && <p class="muted">{t(o.note, lang)}</p>}
          </div>
          <span class="go"><Icon name="external" /></span>
        </a>
      ))}
    </div>
  </section>

  {crypto.length > 0 && (
    <section class="container section-tight">
      <h2 class="h-sm reveal">{s('sup.crypto')}</h2>
      <p class="muted crypto-note reveal">{s('sup.cryptoNote')}</p>
      <div class="grid grid-3">
        {crypto.map((o, i) => (
          <div class:list={['card coin reveal', { preferred: o.preferred }]} style={`--d:${i * 0.06}s`}>
            <div class="coin-head">
              <div>
                <h3>{t(o.name, lang)}</h3>
                <span class="mono net">{o.network}</span>
              </div>
              {o.preferred && <span class="chip">{s('sup.preferred')}</span>}
            </div>
            {o.note && <p class="muted coin-note">{t(o.note, lang)}</p>}
            <button class="addr mono" type="button" data-goatcounter-click={`copy-${o.id}`} data-copy={o.address} data-copied={s('sup.copied')} title={s('sup.copy')}>
              <span>{o.address}</span><Icon name="copy" />
            </button>
            <details class="qr">
              <summary>{s('sup.qr')}</summary>
              <div class="qr-img" set:html={o.qr} />
            </details>
          </div>
        ))}
      </div>
    </section>
  )}
</Base>

<style>
  .links { grid-template-columns: repeat(auto-fill, minmax(min(100%, 300px), 1fr)); }
  .link-opt { display: flex; align-items: center; gap: 1rem; }
  .link-opt.first { grid-column: 1 / -1; padding: clamp(22px, 3vw, 32px); background: linear-gradient(120deg, rgba(189, 0, 255, 0.22), rgba(45, 20, 60, 0.4) 60%); border-color: rgba(189, 0, 255, 0.5); }
  .link-opt.first h3 { font-size: var(--step-2); }
  .opt-icon { width: 52px; height: 52px; flex: none; display: grid; place-items: center; border-radius: 14px; background: var(--primary-soft); border: 1px solid var(--border); color: var(--accent); }
  .first .opt-icon { width: 64px; height: 64px; background: var(--primary); color: white; box-shadow: 0 8px 30px -8px var(--primary-glow); }
  .opt-icon :global(svg) { width: 26px; height: 26px; }
  .opt-text { flex: 1; min-width: 0; }
  .go { color: var(--muted); transition: transform 0.3s var(--ease), color 0.2s; }
  .go :global(svg) { width: 20px; height: 20px; }
  .link-opt:hover .go { color: white; transform: translate(3px, -3px); }

  .h-sm { font-size: var(--step-2); margin-bottom: 0.3rem; }
  .crypto-note { font-size: 0.9rem; margin-bottom: 1.2rem; }
  .coin { display: flex; flex-direction: column; gap: 0.8rem; }
  .coin.preferred { border-color: rgba(189, 0, 255, 0.55); background: linear-gradient(180deg, rgba(189, 0, 255, 0.14), rgba(45, 20, 60, 0.38)); }
  .coin-head { display: flex; justify-content: space-between; align-items: flex-start; }
  .net { font-size: 0.72rem; letter-spacing: 0.08em; color: var(--muted); text-transform: uppercase; }
  .coin-note { font-size: 0.88rem; }
  .addr {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    width: 100%;
    text-align: left;
    padding: 0.7rem 0.8rem;
    font-size: 0.74rem;
    color: var(--text);
    background: rgba(0, 0, 0, 0.35);
    border: 1px solid var(--border-soft);
    border-radius: var(--radius-sm);
    cursor: pointer;
    transition: border-color 0.2s, background 0.2s;
  }
  .addr span { flex: 1; word-break: break-all; }
  .addr :global(svg) { width: 18px; height: 18px; flex: none; color: var(--accent); }
  .addr:hover { border-color: var(--primary); background: rgba(0, 0, 0, 0.5); }
  .qr summary { cursor: pointer; color: var(--muted); font-size: 0.85rem; list-style: none; }
  .qr summary::before { content: '▸ '; color: var(--primary); }
  .qr[open] summary::before { content: '▾ '; }
  .qr-img { margin-top: 0.7rem; width: 180px; max-width: 100%; background: white; border-radius: 10px; padding: 6px; }
</style>
