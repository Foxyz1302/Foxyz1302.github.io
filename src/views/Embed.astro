---
// The embeddable app card (/embed/<app>/), meant for an <iframe> or the
// /embed.js snippet. Kept small: no header, footer or site scripts.
import '@fontsource-variable/outfit';
import '@fontsource-variable/onest';
import Icon from '../components/Icon.astro';
import DownloadButton from '../components/DownloadButton.astro';
import { data, t, href, PLATFORM_LABEL, type App, type Lang } from '../lib/data';
import { latestRelease } from '../lib/releases';
import { ui } from '../i18n/ui';

interface Props { lang: Lang; app: App }
const { lang, app } = Astro.props;
const s = ui(lang);
const release = await latestRelease(app);
const site = data.site.url;
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <title>{app.name} · {data.person.name}</title>
    <script is:inline>
      // ?theme=light for light pages
      if (new URLSearchParams(location.search).get('theme') === 'light') document.documentElement.dataset.theme = 'light';
    </script>
  </head>
  <body>
    <article class="ecard">
      <a class="top" href={new URL(href(`/apps/${app.id}/`, lang), site).href} target="_blank" rel="noopener">
        <img src={app.icon} alt="" width="56" height="56" />
        <div>
          <h1>{app.name}</h1>
          <p class="by">{s('embed.by')} {data.person.name}
            <span class="plats">{app.platforms.map((p) => <span title={PLATFORM_LABEL[p]}><Icon name={p} /></span>)}</span>
          </p>
        </div>
      </a>
      <p class="pitch">{t(app.pitch, lang)}</p>
      <div class="actions">
        <DownloadButton app={app} release={release} lang={lang} compact target="_blank" />
        <a class="btn btn-ghost" data-goatcounter-click={`embed-support-${app.id}`} href={new URL(href('/support/', lang), site).href} target="_blank" rel="noopener"><Icon name="heart" />{s('embed.support')}</a>
      </div>
    </article>
    <script>
      // Tell the page around the iframe how tall the card is (embed.js listens).
      const send = () => parent.postMessage({ type: 'foxyz-embed:height', height: Math.ceil(document.documentElement.getBoundingClientRect().height) }, '*');
      new ResizeObserver(send).observe(document.body);
      send();
    </script>
  </body>
</html>

<style is:global>
  /* no color-scheme here: a dark scheme makes the iframe paint an opaque backdrop */
  :root {
    --bg: #141312; --panel: #1c1a18; --border: rgba(240, 230, 212, 0.16); --text: #efe6d4; --muted: #a39b8d;
    --primary: #d23a2c; --primary-dark: #7d1f17; --accent: #e2b45a; --border-soft: rgba(240, 230, 212, 0.1);
    --font: 'Outfit Variable', 'Onest Variable', system-ui, sans-serif; --mono: ui-monospace, monospace; --radius-sm: 10px;
    --ease: cubic-bezier(0.22, 1, 0.36, 1); --warn: #fbbf24;
  }
  :root[data-theme='light'] {
    --bg: #ffffff; --panel: #faf7f2; --border: rgba(30, 26, 22, 0.18); --text: #1c1a18; --muted: #6b6358;
    --accent: #a3291e; --border-soft: rgba(0, 0, 0, 0.1);
  }
  * { box-sizing: border-box; margin: 0; }
  html, body { background: transparent; }
  body { font-family: var(--font); color: var(--text); padding: 2px; -webkit-font-smoothing: antialiased; }
  a { color: inherit; text-decoration: none; }
  svg { display: block; }
  .ecard {
    background: var(--panel);
    border: 1px solid var(--border);
    border-radius: 12px;
    padding: 16px;
    display: grid;
    gap: 12px;
    max-width: 420px;
  }
  .top { display: flex; gap: 12px; align-items: center; }
  .top img { width: 56px; height: 56px; border-radius: 14px; }
  h1 { font-size: 1.25rem; line-height: 1.1; letter-spacing: -0.02em; }
  .by { color: var(--muted); font-size: 0.82rem; display: flex; align-items: center; gap: 10px; margin-top: 2px; }
  .plats { display: inline-flex; gap: 6px; }
  .plats svg { width: 14px; height: 14px; }
  .pitch { font-size: 0.92rem; line-height: 1.45; }
  .actions { display: flex; flex-wrap: wrap; gap: 8px; align-items: center; }
  .btn {
    display: inline-flex; align-items: center; justify-content: center; gap: 0.45em;
    min-height: 40px; padding: 0 1.05rem; border-radius: 10px; font: 600 0.9rem/1 var(--font);
    border: 1px solid transparent; cursor: pointer; white-space: nowrap; transition: transform 0.2s var(--ease), box-shadow 0.2s, background 0.2s;
  }
  .btn svg { width: 16px; height: 16px; }
  .btn-primary { background: var(--primary); color: #fff8ec; box-shadow: 0 3px 0 var(--primary-dark); }
  .btn-primary:hover { transform: translateY(-1px); box-shadow: 0 4px 0 var(--primary-dark); }
  .btn-ghost { border-color: var(--border-soft); color: var(--text); background: color-mix(in srgb, var(--text) 4%, transparent); }
  .btn-ghost:hover { background: color-mix(in srgb, var(--text) 9%, transparent); }
  .muted { color: var(--muted); }
</style>
